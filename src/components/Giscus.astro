---
// Giscus 评论组件：评论数据存储在 GitHub Discussions 中。
// 启用步骤：
// 1. GitHub 仓库 Settings -> Features 打开 Discussions
// 2. 打开 https://giscus.app 选择仓库，把下面 REPO_ID / CATEGORY 换成生成的值
const REPO_ID = '请到 giscus.app 获取';
const CATEGORY = 'Announcements';
---

<section class="comments">
  <h2>评论</h2>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="MASTER-0x465/personal-blog"
    data-repo-id={REPO_ID}
    data-category={CATEGORY}
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="preferred_color_scheme"
    data-lang="zh-CN"
    crossorigin="anonymous"
    async
  ></script>
</section>